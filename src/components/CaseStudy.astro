---
import { Image, Picture, getImage } from 'astro:assets';
import AppPhone from './AppPhone.astro';
import { kadanzMark, kadanzPlane } from '../data/kadanz';
import Icon from './Icon.astro';
import thuriiMountains from '../assets/thurii/montagnes.webp';
import thuriiPinecone from '../assets/thurii/pomme-de-pin.webp';
import thuriiBranch from '../assets/thurii/branche-de-pin.webp';
import thuriiAcorns from '../assets/thurii/glands.webp';
import type { Project } from '../data/projects';
import { site } from '../data/site';
import { external, withBase } from '../lib/url';

interface Props {
  project: Project;
  next: Project;
}

const { project: p, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const video = p.media?.video;
const photo = p.media?.photo;
const images = p.media?.images ?? [];
const screens = p.media?.screens ?? [];
// Vidéo et photo côte à côte ; les images pleine largeur passent en dessous.
const paired = Boolean(video && photo);
const links = p.links;
const networks = { tiktok: 'TikTok', instagram: 'Instagram', facebook: 'Facebook' } as const;
const poster = video ? await getImage({ src: video.poster, width: 1280, format: 'webp' }) : undefined;
// Illustrations de la charte Thurii, en filigrane (comme sur ses cartes de visite).
const thurii = p.id === 'thurii';
// Kadanz : le billet en filigrane dans l'en-tête, le trajet de l'avion dans « Le défi ».
const kadanz = p.id === 'kadanz';
const t = p.theme;
const vars = [
  `--cs-bg: ${t.bg}`,
  `--cs-panel: ${t.panel}`,
  `--cs-glow: ${t.glow}`,
  `--cs-ink: ${t.ink}`,
  `--cs-ink2: ${t.ink2}`,
  `--cs-accent: ${t.accent}`,
  `--cs-on-accent: ${t.onAccent}`,
  `--cs-accent-text: ${t.accentText}`,
  `--cs-line: ${t.line}`,
  `--cs-title-font: ${p.title.font}`,
  `--cs-title-weight: ${p.title.weight}`,
  `--cs-title-tracking: ${p.title.tracking}`,
].join('; ');
---

<div class:list={['cs', { 'cs--kadanz': kadanz }]} style={vars}>
  {thurii && <Image class="cs__acorns" src={thuriiAcorns} alt="" width={520} loading="lazy" />}
  <div class="cs__wrap cs__bar">
    <button type="button" class="cs__back" data-case-close>
      <Icon name="arrow-left" size={18} />
      Retour aux projets
    </button>
  </div>

  <section class="cs__wrap cs__hero" aria-labelledby={`etude-${p.id}-titre`}>
    <div class="cs__intro">
      <span class="cs__label">{p.kind}</span>
      <h3 class="cs__title" id={`etude-${p.id}-titre`} tabindex="-1">
        {
          p.wordmark ? (
            <>
              <svg class="cs__wordmark" viewBox={p.wordmark.viewBox} fill="currentColor" aria-hidden="true" style={`--wm-scale: ${p.wordmark.scale ?? 1}`}>
                <path d={p.wordmark.d} />
              </svg>
              <span class="sr-only">{p.name}</span>
            </>
          ) : (
            p.name
          )
        }
      </h3>
      <p class="cs__tagline">{p.tagline}</p>
      <dl class="cs__meta">
        {
          p.meta.map((m) => (
            <div>
              <dt>{m.k}</dt>
              <dd>{m.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="cs__visual">
      <div class="cs__glow" aria-hidden="true"></div>
      {
        kadanz && (
          <svg class="cs__hero-ticket" viewBox={kadanzMark.viewBox} aria-hidden="true" focusable="false">
            <path class="cs__hero-ticket-paper" d={kadanzMark.paper} />
            <path class="cs__hero-ticket-ink" d={`${kadanzMark.k}${kadanzMark.perforation}`} />
          </svg>
        )
      }
      <div class="cs__float"><AppPhone app={p.id} /></div>
    </div>
  </section>

  {p.facts.length > 0 && (
  <section class="cs__wrap cs__facts" aria-label="Chiffres clés">
    <div class="cs__facts-grid">
      {
        p.facts.map((f) => (
          <div class="cs__fact">
            <span class="cs__fact-v">{f.v}</span>
            <span class="cs__fact-l">{f.l}</span>
          </div>
        ))
      }
    </div>
  </section>
  )}

  <section class:list={['cs__context', { 'cs__context--decor': thurii }]}>
    {thurii && <Image class="cs__mountains" src={thuriiMountains} alt="" width={1400} loading="lazy" />}
    <div class="cs__wrap cs__context-inner">
      <h4>Le contexte</h4>
      <p>{p.context}</p>
    </div>
  </section>

  <section class="cs__challenge">
    {thurii && <Image class="cs__pinecone" src={thuriiPinecone} alt="" width={460} loading="lazy" />}
    {
      kadanz && (
        <svg class="cs__trip" viewBox="0 0 976 180" aria-hidden="true" focusable="false">
          <path class="cs__trip-ahead" d="M168 82C380 -12 700 -14 948 150" />
          <path class="cs__trip-flown" d="M26 153L104 110" />
          <circle class="cs__trip-from" cx="26" cy="153" r="10" />
          <circle class="cs__trip-to" cx="950" cy="153" r="12" />
          <path class="cs__trip-plane" d={kadanzPlane} transform="translate(130 96) rotate(62) translate(-30 -30) scale(0.5)" />
        </svg>
      )
    }
    <div class="cs__wrap cs__challenge-inner">
      <h4 class="cs__label">Le défi</h4>
      <p>{p.challenge}</p>
    </div>
  </section>

  {
    (video || photo || images.length > 0 || screens.length > 0) && (
      <section class="cs__wrap cs__media" aria-labelledby={`etude-${p.id}-images`}>
        {thurii && <Image class="cs__branch" src={thuriiBranch} alt="" width={620} loading="lazy" />}
        <h4 id={`etude-${p.id}-images`}>En images</h4>
        {(video || photo || images.length > 0) && (
        <div class:list={['cs__media-grid', { 'cs__media-grid--pair': paired }]}>
          {video && (
            <figure class="cs__video">
              <video controls preload="none" playsinline poster={poster?.src} aria-label={video.title}>
                <source src={withBase(video.src)} type="video/mp4" />
              </video>
              <figcaption>{video.title}</figcaption>
            </figure>
          )}
          {photo && (
            <figure class="cs__photo">
              <Picture
                src={photo.src}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200]}
                sizes="(max-width: 800px) 92vw, 520px"
                alt={photo.alt}
                loading="lazy"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          )}
          {images.map((img) => (
            <figure class="cs__image">
              <Picture
                src={img.src}
                formats={['avif', 'webp']}
                widths={[600, 1200, 1800]}
                sizes="(max-width: 1240px) 92vw, 1144px"
                alt={img.alt}
                loading="lazy"
              />
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
        )}
        {screens.length > 0 && (
          <div class="cs__screens">
            {screens.map((sc) => (
              <figure class="cs__screen">
                <span class="cs__bezel">
                  <Picture
                    src={sc.src}
                    formats={['avif', 'webp']}
                    widths={[320, 640, 960]}
                    sizes="(max-width: 800px) 70vw, 290px"
                    alt={sc.alt}
                    loading="lazy"
                  />
                </span>
                <figcaption>{sc.caption}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="cs__wrap cs__done">
    <h4>Ce que j’ai fait</h4>
    <ol>
      {
        p.done.map((d, i) => (
          <li>
            <span class="cs__done-n">{pad(i + 1)}</span>
            <h5>{d.t}</h5>
            <p>{d.d}</p>
          </li>
        ))
      }
    </ol>
    <ul class="cs__stack" aria-label="Technologies">
      {p.stack.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  {
    links && (
      <section class="cs__wrap cs__get" aria-label={`Télécharger et suivre ${p.name}`}>
        <div class="cs__get-col">
          <h4>Télécharger {p.name}</h4>
          {links.note && <p>{links.note}</p>}
          <div class="cs__stores">
            {links.stores.android && (
              <a class="cs__store" href={links.stores.android} {...external}>
                <Icon name="google-play" size={24} />
                <span><small>Disponible sur</small>Google Play</span>
              </a>
            )}
            {links.stores.ios && (
              <a class="cs__store" href={links.stores.ios} {...external}>
                <Icon name="apple" size={24} />
                <span><small>Télécharger dans</small>l’App Store</span>
              </a>
            )}
          </div>
        </div>
        <div class="cs__get-col">
          <h4>Suivre {p.name}</h4>
          <p>Les nouvelles de l’app, sur son site et ses réseaux.</p>
          <div class="cs__follow">
            {links.website && (
              <a class="cs__site" href={links.website} {...external}>
                {links.website.replace(/^https?:\/\//, '')}
                <Icon name="arrow-up-right" size={18} />
              </a>
            )}
            {links.socials.length > 0 && (
              <ul class="cs__socials">
                {links.socials.map((so) => (
                  <li>
                    <a href={so.url} {...external} aria-label={`${p.name} sur ${networks[so.network]}`}>
                      <Icon name={so.network} size={20} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="cs__wrap cs__end">
    <div class="cs__cta">
      <div class="cs__cta-text">
        <h4>Un projet du même genre ?</h4>
        <p>Parlons-en 30 minutes, sans engagement.</p>
      </div>
      <a href={site.calendly} {...external}>
        Réserver un appel
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <button type="button" class="cs__next" data-case-open={next.id}>
      <span class="cs__next-label">Projet suivant</span>
      <span class="cs__next-name">
        {next.name}
        <Icon name="arrow-right" size={40} stroke={1.6} />
      </span>
    </button>
  </section>
</div>

<style>
  .cs {
    position: relative;
    overflow: hidden;
    background: var(--cs-bg);
    color: var(--cs-ink);
    transition: background-color .7s ease, color .7s ease;
  }
  .cs__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: clamp(20px, 4vw, 48px);
  }

  .cs__bar {
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .cs__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 20px 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--cs-ink2);
    background: transparent;
    color: var(--cs-ink);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .cs__hero {
    padding-block: 56px 80px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }
  .cs__intro {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cs__label {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--cs-accent-text);
  }
  .cs__title {
    margin: 0;
    font-family: var(--cs-title-font);
    font-weight: var(--cs-title-weight);
    font-size: clamp(56px, 8.5vw, 124px);
    line-height: .95;
    letter-spacing: var(--cs-title-tracking);
    outline: none;
  }
  /* Glands en haut à droite, comme sur la carte de visite Thurii. */
  .cs > :global(.cs__acorns) {
    position: absolute;
    top: 12px;
    right: max(-60px, calc(50% - 760px));
    width: clamp(180px, 22vw, 320px);
    height: auto;
    opacity: .25;
    transform: rotate(10deg);
    pointer-events: none;
  }
  .cs__wordmark { display: block; height: calc(clamp(64px, 9vw, 120px) * var(--wm-scale, 1)); width: auto; max-width: 100%; }

  /* Filigranes Thurii */
  /* Montagnes en fond de « Le contexte » : image entière (ni recadrée ni déformée), calée en bas à droite. */
  .cs__context { position: relative; overflow: hidden; }
  .cs__context-inner { position: relative; }
  .cs__context--decor .cs__context-inner { min-height: 340px; }
  .cs__context :global(.cs__mountains) {
    position: absolute;
    right: max(0px, calc(50% - 720px));
    bottom: 0;
    width: min(680px, 80%);
    height: auto;
    opacity: .2;
    pointer-events: none;
    /* Le dessin d'origine est encadré (traits sur les côtés et en bas) : on fond ses bords. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 14%, #000 82%, transparent 98%),
      linear-gradient(to top, transparent 4%, #000 34%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 14%, #000 82%, transparent 98%),
      linear-gradient(to top, transparent 4%, #000 34%);
    mask-composite: intersect;
  }
  .cs__challenge { position: relative; overflow: hidden; }
  .cs__challenge-inner { position: relative; }
  /* Pomme de pin à gauche, en partie sous le texte (les illustrations alternent de côté). */
  .cs__challenge :global(.cs__pinecone) {
    position: absolute;
    left: max(-70px, calc(50% - 760px));
    top: 50%;
    width: clamp(160px, 22vw, 300px);
    height: auto;
    opacity: .18;
    transform: translateY(-50%) rotate(14deg);
    pointer-events: none;
  }

  /* Filigranes Kadanz, à l'or du billet. */
  /* En-tête : le billet plein (papier or, K en creux), incliné et à moitié caché par le téléphone. */
  .cs__hero-ticket {
    position: absolute;
    left: -170px;
    top: 40px;
    width: clamp(220px, 22vw, 300px);
    height: auto;
    opacity: .18;
    transform: rotate(-14deg);
    pointer-events: none;
  }
  .cs__hero-ticket-paper { fill: var(--cs-accent-text); }
  /* En une colonne, le téléphone est centré : le billet dépasse à gauche, sans sortir de l'écran. */
  @media (max-width: 1000px) {
    .cs__hero-ticket { left: max(-30px, calc(50% - 300px)); top: 10px; width: 200px; }
  }
  .cs__hero-ticket-ink { fill: none; stroke: var(--cs-bg); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  /* Le défi : le petit trajet de l'avion des e-mails Kadanz, en bas à droite. */
  .cs__trip {
    position: absolute;
    right: max(24px, calc(50% - 640px));
    bottom: 36px;
    width: min(440px, 62%);
    height: auto;
    fill: none;
    stroke-linecap: round;
    opacity: .55;
    pointer-events: none;
  }
  .cs__trip-flown { stroke: var(--cs-accent-text); stroke-width: 6; }
  .cs__trip-ahead { stroke: var(--cs-ink2); stroke-width: 6; stroke-dasharray: 0.01 18; }
  .cs__trip-from { fill: var(--cs-accent-text); }
  .cs__trip-to { stroke: var(--cs-ink2); stroke-width: 5; }
  .cs__trip-plane { fill: var(--cs-accent-text); }

  /* En images : vidéo et photo à la même hauteur (colonnes au prorata de leurs formats). */
  /* Après « Le défi » : le projet en images, avant de détailler mon rôle. */
  .cs__media {
    position: relative;
    padding-top: 88px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .cs__media > h4 {
    position: relative;
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
  }
  .cs__media :global(.cs__branch) {
    position: absolute;
    right: -120px;
    top: -70px;
    width: 300px;
    height: auto;
    opacity: .2;
    transform: scaleX(-1) rotate(-20deg);
    pointer-events: none;
  }
  .cs__media-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .cs__media-grid--pair { grid-template-columns: 16fr 13.5fr; }
  .cs__media-grid--pair > .cs__image { grid-column: 1 / -1; }
  .cs__media figure { margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .cs__media video,
  .cs__media :global(.cs__photo img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    background: var(--cs-panel);
  }
  .cs__media video { aspect-ratio: 16 / 9; }
  .cs__media :global(.cs__photo img) { aspect-ratio: 3 / 2; object-fit: cover; }
  /* Cadre fin : le visuel a le même fond que la page. */
  .cs__media :global(.cs__image img) { display: block; width: 100%; height: auto; border-radius: 20px; box-shadow: 0 0 0 1px var(--cs-line); }
  .cs__media figcaption { font-size: 14px; color: var(--cs-ink2); }
  /* Captures d'écran : trois téléphones côte à côte, en défilement horizontal sur mobile. */
  .cs__screens {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 4vw, 56px);
    padding-inline: clamp(0px, 6vw, 72px);
  }
  .cs__screen { align-items: center; text-align: center; }
  .cs__bezel {
    display: block;
    width: 100%;
    max-width: 290px;
    padding: 7px;
    border-radius: 44px;
    background: #0a1822;
    box-shadow: 0 0 0 1px var(--cs-line), 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  .cs__bezel :global(img) { display: block; width: 100%; height: auto; border-radius: 37px; }
  @media (max-width: 800px) {
    .cs__screens {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(70vw, 300px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 0 12px;
    }
    .cs__screen { scroll-snap-align: center; }
  }
  @media (max-width: 800px) {
    .cs__media-grid--pair { grid-template-columns: minmax(0, 1fr); }
  }
  .cs__tagline {
    margin: 0;
    max-width: 620px;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.35;
  }
  .cs__meta {
    margin: 16px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--cs-line);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
  }
  .cs__meta dt {
    margin-bottom: 6px;
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--cs-ink2);
  }
  .cs__meta dd { margin: 0; font-size: 16px; line-height: 1.5; }
  .cs__visual {
    flex: 1 1 340px;
    min-width: 0;
    position: relative;
    height: 660px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cs__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(440px, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cs-glow);
    transform: translate(-50%, -50%);
  }
  .cs__float {
    position: relative;
    animation: acyll-float 7s ease-in-out infinite;
  }

  .cs__context { border-top: 1px solid var(--cs-line); }
  .cs__context-inner {
    padding-block: 80px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
  }
  .cs__context h4 {
    flex: 1 1 240px;
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
  }
  .cs__context p {
    flex: 999 1 520px;
    margin: 0;
    font-size: 20px;
    line-height: 1.65;
    color: var(--cs-ink2);
  }

  .cs__challenge { background: var(--cs-panel); transition: background-color .7s ease; }
  .cs__challenge-inner {
    padding-block: 88px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cs__challenge p {
    margin: 0;
    max-width: 980px;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.2;
    letter-spacing: -.015em;
  }

  .cs__done {
    padding-block: 88px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .cs__done > h4 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
  }
  .cs__done ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 32px;
  }
  .cs__done li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
    border-top: 2px solid var(--cs-accent);
  }
  .cs__done-n { font-size: 14px; font-weight: 700; color: var(--cs-accent-text); }
  .cs__done h5 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
  }
  .cs__done li p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--cs-ink2); }

  /* Chiffres clés juste sous l'en-tête : les preuves avant le récit. */
  .cs__facts { margin-top: -24px; padding-bottom: 72px; }
  .cs__facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }
  .cs__fact {
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--cs-panel);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cs__fact-v {
    font-family: var(--cs-title-font);
    font-weight: var(--cs-title-weight);
    font-size: 48px;
