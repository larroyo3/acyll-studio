---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Stars from './Stars.astro';
import portrait from '../assets/portrait-lucas.png';
import { technologies } from '../data/content';
import { site } from '../data/site';
import { external } from '../lib/url';
---

<section id="top" class="hero container">
  <div class="bento hero__grid">
    <div class="hero-main a-rise span-2">
      <Logo class="hero-main__mark" />
      <span class="hero-main__badge">Studio de développement mobile | Android &amp; iOS</span>
      <div class="hero-main__body">
        <h1>Des apps mobiles qui font grandir votre activité.</h1>
        <p>
          Je conçois et développe des applications Android et iOS performantes, de l’idée à la publication sur les
          stores. Un seul interlocuteur, un budget maîtrisé.
        </p>
        <div class="hero-main__ctas">
          <a class="btn btn--light" href={site.calendly} {...external}>
            Réserver un appel gratuit
            <Icon name="arrow-right" size={18} class="arr" />
          </a>
          <a class="btn btn--outline" href="#work">Voir les réalisations</a>
        </div>
      </div>
    </div>

    <div class="hero-portrait a-rise d1">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[400, 640, 960]}
        sizes="(max-width: 600px) 92vw, (max-width: 900px) 48vw, 440px"
        alt={`Portrait de ${site.owner}, fondateur d’${site.name}`}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-portrait__card">
        <span class="hero-portrait__name">{site.owner}</span>
        <span class="hero-portrait__role">{site.role}</span>
        <span class="hero-portrait__rating">
          <Stars size={14} label="Noté 5 sur 5 sur Malt" />
          <span aria-hidden="true">5/5 sur Malt</span>
        </span>
      </div>
    </div>

    <div class="hero-side">
      <div class="hero-tile card tile a-rise d2">
        <span class="kicker hero-tile__status"><span class="dot a-pulse"></span>Disponible</span>
        <p>Nouveaux projets dès maintenant, à {site.city} ou à distance. Devis gratuit.</p>
        <a class="nav-link hero-tile__link" href={site.calendly} {...external}>Choisir un créneau →</a>
      </div>

      <div class="hero-tile hero-tile--stat card tile a-rise d3">
        <span class="hero-tile__number">20 000+</span>
        <p>téléchargements sur Dict.fr Mobile, une app à laquelle j’ai contribué.</p>
      </div>

      <div class="hero-tech card tile a-rise d4">
        <span class="kicker hero-tech__label">Technologies</span>
        <p class="sr-only">{technologies.flat().map((t) => t.name).join(', ')}</p>
        {
          technologies.map((row, i) => (
            <div class="hero-tech__row" aria-hidden="true">
              <div class:list={['marquee', i % 2 ? 'mq-rev' : 'mq']}>
                {[0, 1].map(() => (
                  <div class="hero-tech__group">
                    {[...row, ...row].map((tech) => (
                      <span class:list={['hero-tech__pill', { 'is-highlight': tech.highlight }]}>{tech.name}</span>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: 28px 24px; }
  .hero__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  /* Carte principale */
  .hero-main {
    grid-column: span 2;
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 3.4vw, 44px);
    border-radius: 28px;
    background: var(--color-primary);
    color: var(--color-on-background);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  /* Logo en filigrane : les faces de ACYLL sont transparentes et laissent voir le rouge. */
  .hero-main :global(.hero-main__mark) {
    position: absolute;
    right: -18px;
    bottom: 6px;
    height: auto;
    width: min(250px, 42%);
    color: color-mix(in srgb, var(--color-primary-hover) 65%, var(--color-primary));
    transform: rotate(-8deg);
    pointer-events: none;
  }
  .hero-main__badge {
    position: relative;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 252, 252, .45);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .hero-main__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero-main h1 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(38px, 4.4vw, 60px);
    line-height: 1.04;
    letter-spacing: -.03em;
  }
  .hero-main p {
    margin: 0;
    max-width: 480px;
    font-size: 17px;
    line-height: 1.6;
  }
  .hero-main__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Portrait */
  .hero-portrait {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background: var(--surface-card);
    min-height: 340px;
  }
  .hero-portrait :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-portrait__card {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 14px 16px;
    border-radius: 18px;
    background: var(--surface-overlay);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero-portrait__name { font-weight: 700; font-size: 16px; }
  .hero-portrait__role { font-size: 13px; color: var(--text-secondary); }
  .hero-portrait__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
  }

  /* Colonne de droite : trois tuiles compactes empilées */
  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .hero-side > * { flex: 1 1 auto; }

  .hero-tile {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero-tile p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .hero-tile__status { display: inline-flex; align-items: center; gap: 10px; }
  /* Le lien se cale en bas de la tuile, comme un bouton. */
  .hero-tile__link {
    margin-top: auto;
    align-self: flex-start;
    font-weight: 700;
    font-size: 14px;
  }
  /* Le chiffre prend toute la largeur de la tuile (« 20 000+ » fait environ 3,9 fois sa taille). */
  .hero-tile--stat { justify-content: space-between; container-type: inline-size; }
  .hero-tile__number {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: min(68px, 25.5cqi);
    line-height: 1;
    letter-spacing: -.03em;
  }

  /* Technologies */
  .hero-tech {
    padding: 22px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }
  /* Titre en haut, les trois lignes groupées en bas. */
  .hero-tech__label { padding: 0 24px 4px; margin-bottom: auto; color: var(--text-muted); }
  .hero-tech__row { overflow: hidden; }
  .hero-tech__group { display: flex; gap: 8px; padding-right: 8px; }
  .hero-tech__pill {
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    font-size: 13px;
    white-space: nowrap;
  }
  .hero-tech__pill.is-highlight {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Tablette : la carte principale sur toute la largeur, puis portrait et tuiles côte à côte. */
  @media (max-width: 900px) {
    .hero-portrait { min-height: 460px; }
  }
  @media (max-width: 600px) {
    .hero-portrait { min-height: 420px; }
  }
</style>
