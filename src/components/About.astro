---
import { Picture } from 'astro:assets';
import Wordmark from './Wordmark.astro';
import portrait from '../assets/portrait.png';
import { timeline } from '../data/content';
import { site } from '../data/site';
import { external } from '../lib/url';
---

<section id="apropos" class="container about">
  <div class="bento about__grid">
    <div class="about__photo reveal">
      <Picture
        src={portrait}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 1040]}
        sizes="(max-width: 600px) 92vw, (max-width: 900px) 48vw, 520px"
        alt={`Portrait de ${site.owner}`}
      />
      <Wordmark name="lucas" class="about__signature" />
    </div>
    <div class="card reveal span-2 about__card">
      <span class="eyebrow">À propos</span>
      <h2>Derrière Acyll Studio, un développeur passionné par le mobile</h2>
      <p class="about__text">
        Je m’appelle {site.owner}. Je conçois et développe des applications mobiles depuis plus de trois ans, en startup,
        en entreprise et pour mes propres projets. Ce que j’aime : suivre une app sur tout son cycle de vie, et conseiller
        mes clients au-delà du code.
      </p>
      <ol class="about__timeline">
        {
          timeline.map((step) => (
            <li>
              <span class="about__period">{step.period}</span>
              <span class="about__place">{step.place}</span>
              <span class="about__role">{step.role}</span>
            </li>
          ))
        }
      </ol>
      <div class="about__links">
        <a class="btn btn--sm btn--primary" href={site.linkedin} {...external}>Voir mon profil LinkedIn</a>
        <a class="btn btn--sm btn--ghost" href={site.malt} {...external}>Mon profil Malt</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about { padding-block: 104px 32px; }
  .about__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .about__photo {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    min-height: 520px;
    background: var(--surface-card);
  }
  .about__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__photo :global(.about__signature) {
    --wm-size: 64px;
    position: absolute;
    left: 20px;
    bottom: 26px;
    color: var(--color-on-background);
    transform: rotate(-6deg);
  }

  .about__card {
    grid-column: span 2;
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .about__card h2 {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.1;
    letter-spacing: -.02em;
  }
  .about__text { margin: 0; font-size: 17px; line-height: 1.7; color: var(--text-secondary); }
  .about__timeline {
    list-style: none;
    margin: 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: 20px;
  }
  .about__timeline li { display: flex; flex-direction: column; gap: 4px; }
  .about__period { font-size: 13px; font-weight: 700; color: var(--text-muted); }
  .about__place { font-weight: 700; }
  .about__role { font-size: 14px; color: var(--text-secondary); }
  .about__links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: auto; }

  @media (max-width: 600px) {
    .about__photo { min-height: 440px; }
  }
</style>
