---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { external } from '../lib/url';

interface Props {
  /** Préfixe des ancres : vide sur l'accueil, URL de l'accueil sur les autres pages. */
  home?: string;
}

const { home = '' } = Astro.props;
const links = [
  { id: 'work', label: 'Réalisations' },
  { id: 'services', label: 'Services' },
  { id: 'avis', label: 'Avis' },
  { id: 'process', label: 'Méthode' },
  { id: 'tarifs', label: 'Tarifs' },
  { id: 'faq', label: 'FAQ' },
];
---

<a class="announce" href={site.calendly} {...external}>
  <span class="announce__dot a-pulse" aria-hidden="true"></span>
  <span>Disponible dès maintenant pour de nouveaux projets<span class="announce__more"> · Réserver un appel découverte gratuit</span> →</span>
</a>

<div class="header-wrap">
  <header class="header" data-header>
    <a href={`${home}#top`} class="brand" aria-label="Acyll Studio, accueil">
      <Wordmark name="acyll" />
      <span class="brand__studio">Studio</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      <ul class="nav__links" id="nav-links">
        {
          links.map((link) => (
            <li>
              <a class="nav-link" href={`${home}#${link.id}`}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav__menu-cta">
          <a class="btn btn--primary" href={`${home}#contact`}>Démarrer un projet</a>
        </li>
      </ul>
      <a class="btn btn--primary nav__cta" href={`${home}#contact`}>Démarrer un projet</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <Icon name="menu" size={20} class="nav__icon-open" />
        <Icon name="close" size={20} class="nav__icon-close" />
      </button>
    </nav>
  </header>
</div>

<style>
  .announce {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--color-primary);
    color: var(--color-on-background);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }
  .announce__dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .header-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px clamp(12px, 3vw, 32px) 0;
  }
  .header {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 24px;
    border-radius: var(--radius-pill);
    background: var(--surface-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 32px;
    text-decoration: none;
  }
  .brand__studio {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px 22px;
    font-size: 14px;
  }
  .nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }
  .nav .btn { min-height: 44px; padding: 0 20px; font-size: 14px; }
  .nav__menu-cta { display: none; }
  .nav__toggle { display: none; }

  @media (max-width: 1000px) {
    .header { padding-left: 20px; }
    .nav { gap: 8px; }
    .nav__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    .nav__toggle :global(.nav__icon-close) { display: none; }
    .header[data-open] .nav__toggle :global(.nav__icon-open) { display: none; }
    .header[data-open] .nav__toggle :global(.nav__icon-close) { display: block; }

    .nav__links {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 8px;
      border-radius: 28px;
      background: var(--surface-card);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-raised);
      font-size: 16px;
    }
    .header[data-open] .nav__links { display: flex; }
    .nav__links .nav-link {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding: 0 16px;
      border-radius: 20px;
    }
    .nav__links .nav-link::after { display: none; }
    .nav__links .nav-link:hover { background: var(--color-primary-muted); }
  }

  @media (max-width: 520px) {
    .announce__more { display: none; }
    .nav__cta { display: none; }
    .nav__menu-cta { display: block; padding-top: 6px; }
    .nav__menu-cta .btn { width: 100%; min-height: 52px; font-size: 16px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelectorAll('#nav-links a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });
    matchMedia('(min-width: 1001px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
