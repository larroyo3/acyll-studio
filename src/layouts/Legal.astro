---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';
import Base from './Base.astro';

interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
const home = withBase('/');
---

<Base title={`${title} · ${site.name}`}>
  <Header home={home} />
  <main id="contenu" class="container legal">
    <a class="nav-link legal__back" href={home}>← Retour à l’accueil</a>
    <h1 class="h2">{title}</h1>
    <p class="legal__updated">Dernière mise à jour : {updated}</p>
    <div class="legal__body">
      <slot />
    </div>
  </main>
  <Footer home={home} />
</Base>

<style>
  .legal {
    max-width: 860px;
    padding-block: 72px 104px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .legal__back { align-self: flex-start; font-size: 14px; font-weight: 700; color: var(--text-secondary); }
  .legal__updated { margin: 0; font-size: 14px; color: var(--text-muted); }
  .legal__body {
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .legal__body :global(h2) {
    margin: 40px 0 12px;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.3;
    color: var(--text-primary);
  }
  .legal__body :global(p),
  .legal__body :global(ul) { margin: 0 0 12px; }
  .legal__body :global(strong) { color: var(--text-primary); }
</style>
