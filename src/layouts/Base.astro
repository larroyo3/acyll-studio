---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/jost/latin-200.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.png';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 1200, height: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: new URL(withBase('/'), Astro.site).href,
  image: ogImageUrl.href,
  email: site.email,
  areaServed: 'FR',
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'FR' },
  founder: { '@type': 'Person', name: site.owner, jobTitle: 'Développeur mobile' },
  sameAs: [site.linkedin, site.malt, site.github],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#200307" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`Portrait de ${site.owner}, fondateur d’${site.name}`} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
